(in-package :alloy-desktop)

(defgeneric pane-pressed (pane button position modifiers))
(defgeneric pane-double-pressed (pane button position modifiers))
(defgeneric pane-dragged (pane position modifiers))
(defgeneric pane-released (pane button position modifiers))
(defgeneric pane-moved (pane position modifiers))
(defgeneric pane-entered (pane position modifiers))
(defgeneric pane-left (pane position modifiers))
(defgeneric key-pressed (pane key modifiers))
(defgeneric draw-pane (pane renderer))
(defgeneric pane-scrolled (pane event modifiers)
  (:documentation "Offer the wheel EVENT (an alloy:scroll: location, dx, dy) over the scrolled
PANE to the host before the pane scrolls itself; MODIFIERS lists :shift, :command and
:option. True when the host consumed the wheel."))
(defgeneric pane-resized (pane width height))
(defgeneric window-activated (window active-p))
(defgeneric window-closing (window))
(defgeneric window-closed (window))
(defgeneric window-shown (window)
  (:documentation "Called at the end of SHOW-WINDOW once WINDOW is on screen."))
(defgeneric drag-started (source position modifiers))
(defgeneric drag-entered (target payload position modifiers))
(defgeneric drag-moved (target payload position modifiers))
(defgeneric drag-left (target payload))
(defgeneric drop-received (target payload position modifiers))
(defgeneric files-dropped (window paths position)
  (:documentation "Offer the files at PATHS, dropped from another application at POSITION
(an Alloy point in WINDOW), to the host. True when the host took them; a drop nobody
takes is declined."))
(defgeneric item-action (item value))

(defgeneric show-window (window))
(defgeneric hide-window (window))
(defgeneric close-window (window &key force now))
(defgeneric window-visible-p (window))
(defgeneric window-title (window))
(defgeneric (setf window-title) (title window))
(defgeneric window-bounds (window))
(defgeneric window-focused-p (window))
(defgeneric window-focus-root (window))

;; Host policy hooks of the window assembly and the event loop, each with a
;; neutral default.
(defgeneric window-render-suspended-p (window)
  (:documentation "True while WINDOW must not be repainted from the UI thread: the
frame loop skips it and a repaint the window system asks for is refused.")
  (:method ((window t)) nil))

(defgeneric window-scale-changed (window scale)
  (:documentation "Called once WINDOW's new content SCALE has been applied to its UI.
The default records SCALE (NOTE-CONTENT-SCALE).")
  (:method ((window t) scale)
    (declare (ignore window))
    (note-content-scale scale)
    nil))

(defgeneric window-menu-model (window)
  (:documentation "The menu bar model (a list of MENU entries) whose accelerators
WINDOW's command-key presses run, or NIL.")
  (:method ((window t)) nil))

;; Neutral callback defaults. Host bridges specialize these on their own classes.
(defmethod pane-pressed ((pane t) button position modifiers)
  (declare (ignore pane button position modifiers)) nil)
(defmethod pane-double-pressed ((pane t) button position modifiers)
  (declare (ignore pane button position modifiers)) nil)
(defmethod pane-dragged ((pane t) position modifiers)
  (declare (ignore pane position modifiers)) nil)
(defmethod pane-released ((pane t) button position modifiers)
  (declare (ignore pane button position modifiers)) nil)
(defmethod pane-moved ((pane t) position modifiers)
  (declare (ignore pane position modifiers)) nil)
(defmethod pane-entered ((pane t) position modifiers)
  (declare (ignore pane position modifiers)) nil)
(defmethod pane-left ((pane t) position modifiers)
  (declare (ignore pane position modifiers)) nil)
(defmethod key-pressed ((pane t) key modifiers)
  (declare (ignore pane key modifiers)) nil)
(defmethod draw-pane ((pane t) renderer)
  (declare (ignore pane renderer)) nil)
(defmethod pane-scrolled ((pane t) event modifiers)
  (declare (ignore pane event modifiers)) nil)
(defmethod pane-resized ((pane t) width height)
  (declare (ignore pane width height)) nil)
(defmethod window-activated ((window t) active-p)
  (declare (ignore window active-p)) nil)
(defmethod window-closing ((window t))
  (declare (ignore window)) nil)
(defmethod window-closed ((window t))
  (declare (ignore window)) nil)
(defmethod window-shown ((window t))
  (declare (ignore window)) nil)
(defmethod drag-started ((source t) position modifiers)
  (declare (ignore source position modifiers)) nil)
(defmethod drag-entered ((target t) payload position modifiers)
  (declare (ignore target payload position modifiers)) nil)
(defmethod drag-moved ((target t) payload position modifiers)
  (declare (ignore target payload position modifiers)) nil)
(defmethod drag-left ((target t) payload)
  (declare (ignore target payload)) nil)
(defmethod drop-received ((target t) payload position modifiers)
  (declare (ignore target payload position modifiers)) nil)
(defmethod files-dropped ((window t) paths position)
  (declare (ignore window paths position)) nil)
(defmethod item-action ((item t) value)
  (declare (ignore item value)) nil)
